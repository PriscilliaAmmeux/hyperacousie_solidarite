---
import Navbar from '../NavBar/NavBar.astro';
import NavBarMobile from '../NavBarMobile/NavBarMobile.astro';
import './Header.css';
import '../../styles/variables.css';

export interface Props {
  currentPath?: string;
}

const { currentPath } = Astro.props;
---

<header class="relative m-0 p-0">


<!-- Navigation desktop -->
  <section class="desktop-nav-section bg-slate-800 text-white shadow-lg">
    <div class="w-full py-4">
      <Navbar currentPath={currentPath} />
    </div>
  </section>

  <!-- Navigation mobile -->
  <section class="mobile-logo-section py-4 px-4 flex justify-start items-center">
      <img 
        src="/logo.webp" 
        alt="Logo Hyperacousie Solidarité"
        class="size-logo-mobile "
      />
       <div class="logo-text-mobile">
          <p>Hyperacousie</p>
          <p>Solidarité</p>
        </div>
  </section>

  <div class="mobile-navbar-container">
    <NavBarMobile currentPath={currentPath} />
  </div>
</header>

