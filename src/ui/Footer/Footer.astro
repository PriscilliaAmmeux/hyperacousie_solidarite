---
const currentYear = new Date().getFullYear();

import './Footer.css';
import '../../styles/variables.css';
---


<footer class="margin-footer" style="background-color: var(--color-teal);">
  <div class="max-w-7xl mx-auto py-10 px-6">
    <img
      src="/logo-footer.webp"
      alt="Logo Hyperacousie Solidarité"
      class="mb-6 footer-logo-overlap"
      style="height: 150px; width: auto;"
    />


    <div class="footer-links grid grid-cols-1 md:grid-cols-3 gap-8 text-sm">
  <ul>
    <li><a href="/">Accueil</a></li>
    <li><a href="/comprendre">Comprendre l'hyperacousie</a></li>
    <li><a href="/temoignages">Témoignages</a></li>
    <li><a href="/ressources">Ressources</a></li>
    <li><a href="/le-coin-des-experts">Le coin des experts</a></li>
  </ul>

  <ul>
    <li><a href="/adhesions-dons">Adhésions et dons</a></li>
    <li><a href="/mentions-legales">Mentions légales</a></li>
    <li><a href="/confidentialite">Politiques de confidentialités</a></li>
    <li><a href="mailto:hyperacousiesolidarite[@]gmail.com">Contact</a></li>
  </ul>
  <div class="footer-social-col">
      <div class="footer-partner-logo">
        <img
          src="/FNATH-Logo.webp"
          alt="Logo de la FNATH"
          class="footer-partner-logo-image"
          loading="lazy"
        />
      </div>
      <div class="footer-social">
        <a href="https://www.linkedin.com/company/hyperacousie-solidarit%C3%A9/posts/?feedView=all" target="_blank" rel="noopener" aria-label="LinkedIn" class="footer-social-link">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="4"/>
            <path d="M8 11v5"/>
            <circle cx="8" cy="8" r="1"/>
            <path d="M12 16v-5"/>
            <path d="M16 16v-3a2 2 0 0 0-4 0"/>
          </svg>
        </a>
        <a href="https://www.facebook.com/groups/1038131074387271/?ref=share%5C" target="_blank" rel="noopener" aria-label="Facebook" class="footer-social-link">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="4"/>
            <path d="M16 8h-2a2 2 0 0 0-2 2v2h4"/>
            <path d="M12 16v-4"/>
          </svg>
        </a>
        <a href="https://www.instagram.com/hyperacousie.solidarite?igsh=MXRhY29wYXJ6ZXdsdg==" target="_blank" rel="noopener" aria-label="Instagram" class="footer-social-link">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5"/>
            <circle cx="12" cy="12" r="4"/>
            <circle cx="17" cy="7" r="1"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  </div>

   
  <div class="footer-bottom border-t border-black mt-6 pt-4 text-sm">
    <p>&copy; {currentYear} Hyperacousie Solidarité. Tous droits réservés.</p>
    <p class="mt-2">Site développé & designé par <a href="https://www.pixelia-and-co.fr/" target="_blank" rel="noopener noreferrer" class="footer-link"><span class="font-bold">Pixelia&Co</span></a></p>
  </div>


</footer>
