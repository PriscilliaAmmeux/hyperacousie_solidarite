---
import Title from "../Title/Title.astro";
import videos from "../../data/videos.json";
import "./VideoRessource.css";

// Mélanger les vidéos de manière aléatoire à chaque chargement
const shuffledVideos = [...videos].sort(() => Math.random() - 0.5);
---
<section id="videos" class="video-ressource-section">
  <Title 
    text="Découvrez les témoignages vidéos"
    className="section-title-video-ressource"
    level="2"
  />
 
  <div class="swiper videoRessourceSwiper">
    <div class="swiper-wrapper">
      {shuffledVideos.map((video) => (
        <div class="swiper-slide">
          <div class="video-ressource-card">
            <h3 class="video-ressource-title">{video.title}</h3>       
            <div class="video-ressource-iframe-container">
              <iframe
                src={`https://www.youtube.com/embed/${video.youtubeId}`}
                title="YouTube video player"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                class="video-ressource-iframe"
              />
            </div>
            <p class="video-ressource-desc">{video.description}</p>
            <button
              type="button"
              class="youtube-btn"
              aria-label={`Regarder la vidéo ${video.title} sur YouTube`}
              onclick={`window.open('https://www.youtube.com/watch?v=${video.youtubeId}', '_blank', 'noopener')`}
            >
              <svg class="youtube-btn-icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="white" aria-hidden="true">
                <path d="M8 5v14l11-7z"/>
              </svg>
              Regarder sur YouTube
            </button>
          </div>
        </div>
      ))}
    </div>
    <div class="swiper-button-prev video-nav-prev"></div>
    <div class="swiper-button-next video-nav-next"></div>

  </div>
</section>

<script src="./VideoRessource.js" />