---

<section class="section-fiches" id="conseils">
  <a
    class="section-fiches-link"
    href="/fiches/fiches-pratiques"
    aria-label="Découvrir les fiches pratiques"
  >
    <img
      src="/guide-et-fiches.webp"
      alt="Guide et fiches pratiques : découvrir toutes les fiches pour mieux vivre avec l’hyperacousie"
      loading="lazy"
    />
  </a>
  <a
    class="section-fiches-link"
    id="aides"
    href="/fiches/fiches-reflexes"
    aria-label="Découvrir les fiches aides et démarches"
  >
    <img
      src="/aides-et-demarches.webp"
      alt="Aides et démarches : accéder aux fiches réflexes"
      loading="lazy"
    />
  </a>
</section>

<style>
  .section-fiches {
    display: flex;
    align-items: stretch;
    justify-content: center;
    gap: 2rem;
    max-width: 1200px;
    margin: 3rem auto;
    padding: 0 1rem;
  }

  .section-fiches-link {
    display: block;
    flex: 1 1 0;
    min-width: 0;
    border-radius: 12px;
  }

  .section-fiches-link:focus-visible {
    outline: 3px solid var(--color-teal);
    outline-offset: 4px;
  }

  .section-fiches img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
  }

  @media (max-width: 700px) {
    .section-fiches {
      flex-direction: column;
      gap: 1.5rem;
    }
  }
</style>