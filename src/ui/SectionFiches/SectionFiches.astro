---
import Button from "../Button/Button.astro";

---

<div style="display: flex; gap: 2rem; margin: 3rem auto; max-width: 1200px; flex-wrap: wrap; justify-content: center;">
  <section id="conseils" style="text-align:center; padding: 2.5rem; flex: 1; min-width: 300px; max-width: 500px; background: #fff; border: 3px solid var(--color-teal); border-radius: 12px;">
    <p style="font-size: 1.2rem; margin-bottom: 1.5rem; color: var(--color-black); font-weight: 500;">
      💁‍♀️ Conseils pratiques & repères 
    </p>
    <Button
      variant="teal"
      size="sm"
      href="/fiches/fiches-pratiques"
    >
     Ici retrouvez (infos, conseils, bonnes pratiques) →
    </Button>
  </section>
  <section id="aides" style="text-align:center; padding: 2.5rem; flex: 1; min-width: 300px; max-width: 500px; background: #fff; border: 3px solid var(--color-teal); border-radius: 12px;">
    <p style="font-size: 1.2rem; margin-bottom: 1.5rem; color: var(--color-black); font-weight: 500;">
      👩‍💻  Aides, démarches & accompagnement
    </p>
    <Button
      variant="teal"
      size="sm"
      href="/fiches/fiches-reflexes"
    >
      ici retrouvez (démarches, droits, administratif) →
    </Button>
  </section>
</div>