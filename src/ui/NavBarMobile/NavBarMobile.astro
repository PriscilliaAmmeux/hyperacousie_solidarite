---
// Mobile navigation component for Hyperacousie Solidarité
import { isCurrentPage } from '../../utils/helpers.ts';
import './NavBarMobile.css';
import '../../styles/variables.css';

const { currentPath = '' } = Astro.props;

const mobileNavigationItems = [
  { href: "/", label: "Accueil" },
  { href: "/comprendre", label: "Comprendre l'hyperacousie" },
  { href: "/temoignages", label: "Témoignages" },
  { href: "/ressources", label: "Ressources" },
  { href: "/adhesions-dons", label: "Adhésions et dons" }, // uniquement mobile
  { href: "/contact", label: "Contact" },
];

// Icons for each menu (using simple SVG icons)
const getIcon = (href: string) => {
  switch (href) {
    case '/':
      // Maison
      return `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>`;
    case '/comprendre':
      // Ampoule
      return `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 21h6v-1H9v1zm3-19C7.48 2 4 5.48 4 10c0 3.31 2.69 6 6 6v3h4v-3c3.31 0 6-2.69 6-6 0-4.52-3.48-8-8-8zm0 14c-2.21 0-4-1.79-4-4 0-2.21 1.79-4 4-4s4 1.79 4 4c0 2.21-1.79 4-4 4z"/></svg>`;
    case '/temoignages':
      // Bulles de dialogue
      return `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M21 6.5a2.5 2.5 0 0 0-2.5-2.5h-13A2.5 2.5 0 0 0 3 6.5v7A2.5 2.5 0 0 0 5.5 16H6v3l3-3h7.5A2.5 2.5 0 0 0 19 13.5v-7z"/></svg>`;
    case '/ressources':
      // Livre
      return `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 2H8c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 18H8V4h11v16zM6 6H4v16c0 1.1.9 2 2 2h12v-2H6V6z"/></svg>`;
    case '/adhesions-dons':
      // Cœur/main
      return `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.1 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41 0.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54l-1.35 1.31z"/></svg>`;
    case '/contact':
      // Enveloppe
      return `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>`;
    default:
      // Étoile
      return `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21 16.54 13.97 22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>`;
  }
};

// Short labels for mobile
const getMobileLabel = (href: string) => {
  switch (href) {
    case '/':
      return 'Accueil';
    case '/comprendre':
      return 'Comprendre';
    case '/temoignages':
      return 'Témoignages';
    case '/ressources':
      return 'Ressources';
    case '/contact':
      return 'Contact';
    case '/adhesions-dons':
      return 'Adhésions-Dons';
    default:
      return 'Menu';
  }
};
---

<!-- Mobile Bottom Navigation -->
<nav 
  class="mobile-nav-bottom"
  role="navigation" 
  aria-label="Main mobile navigation"
>
  <div class="mobile-nav-container">
    {mobileNavigationItems.map((item) => (
      <a 
        href={item.href}
        class={`mobile-nav-item ${
          isCurrentPage(item.href, currentPath)
            ? 'mobile-nav-active'
            : 'mobile-nav-default'
        }`}
        aria-current={isCurrentPage(item.href, currentPath) ? 'page' : undefined}
        aria-label={`Go to ${item.label}`}
      >
        <div class="mobile-nav-icon" set:html={getIcon(item.href)} />
      
      </a>
    ))}
  </div>
</nav>


