---
import FactSheet from '../components/FactSheet/FactSheet.astro';
import NetworkingSharing from '../components/NetworkingSharing/NetworkingSharing.astro';
import PreventionAwareness from '../components/PreventionAwareness/PreventionAwareness.astro';
import ReflexSheet from '../components/ReflexSheet/ReflexSheet.astro';
import ScientificResourcesTestimonials from '../components/ScientificResourcesTestimonials/ScientificResourcesTestimonials.astro';
import Layout from '../layouts/Layout.astro';
import Plaquette from '../ui/Plaquette/Plaquette.astro';
import Title from '../ui/Title/Title.astro';
import Button from '../ui/Button/Button.astro';
import '../styles/variables.css';
---

<Layout 
  title="Ressources Hyperacousie : guides, témoignages et cartes"
  description="Accédez à des fiches pratiques, études, témoignages et cartes interactives pour mieux comprendre, prévenir et vivre avec l’hyperacousie."
>
 <section style="text-align:center">
    <Title
      text="Ressources"
      className="section-title-page"
      level="2"
    />
  </section>

<section style="text-align:center; margin: 3rem auto; padding: 2.5rem; max-width: 800px; background: #fff; border: 3px solid var(--color-teal); border-radius: 12px;">
  <p style="font-size: 1.2rem; margin-bottom: 1.5rem; color: var(--color-black); font-weight: 500;">
    💡 Découvrez nos fiches pratiques pour mieux vivre au quotidien
  </p>
  <Button
    variant="teal"
    size="sm"
    href="/fiches"
  >
    Accéder aux conseils pratiques & repères →
  </Button>
</section>

<ScientificResourcesTestimonials />
<NetworkingSharing />
<PreventionAwareness />
<Plaquette />

</Layout>