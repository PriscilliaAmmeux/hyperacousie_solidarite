---
import Layout from '../layouts/Layout.astro';
import Title from '../ui/Title/Title.astro';
import Button from '../ui/Button/Button.astro';
import ScientificArticle from '../components/ScientificArticle/ScientificArticle.astro';
import '../components/ScientificArticle/ScientificArticle.css';
import '../styles/le-coin-des-experts.css';
import ScientificResourcesTestimonials from '../components/ScientificResourcesTestimonials/ScientificResourcesTestimonials.astro';
---
<Layout
title="Le coin des experts"
description="Découvrez les conseils et analyses d'experts en hyperacousie : audiologistes, chercheurs et professionnels de santé partagent leurs connaissances pour mieux comprendre et gérer cette condition.">
	<section class="experts-hero">
		<div class="experts-hero-inner">
			<Title text="Le coin des experts" level='2' />
			<p>
				Un espace dédié aux contenus scientifiques et au suivi de la recherche autour de l'hyperacousie.
			</p>
		</div>
	</section>

	<section class="earbot-feature" id="earbot" aria-labelledby="earbot-title">
		<div class="earbot-feature-content">
			<p class="earbot-eyebrow">🤖 Un outil pour explorer les connaissances scientifiques</p>
			<h2 id="earbot-title">Découvrez EarBot, l’agent IA dédié à l’hyperacousie</h2>
			<p>
				Créé par Aurélien Rumiano, EarBot répond en français à vos questions sur les mécanismes,
				les symptômes et la recherche sur l’hyperacousie. Ses réponses s’appuient sur 26 études
				scientifiques consacrées à cette pathologie.
			</p>
			<p>
				L’outil est gratuit pour les utilisateurs. Chaque réponse coûte environ un centime,
				pris en charge jusqu’ici par son créateur. Un don facultatif peut être proposé depuis
				la page du bot pour contribuer à ses frais de fonctionnement ; aucun paiement n’est
				requis pour poser des questions.
			</p>
			<Button
				class="earbot-cta"
				variant="teal"
				size="md"
				href="https://enstips.com/fr/earbot-your-hyperacusis-ai-agent/"
				target="_blank"
				rel="noopener noreferrer"
			>
				Poser une question à EarBot ↗
			</Button>
			<p class="earbot-disclaimer">
				<strong>À savoir :</strong> EarBot est un outil d’information et de vulgarisation. Il ne
				remplace pas un avis médical et ne permet ni diagnostic ni prise en charge médicale ;
				ses réponses peuvent être imparfaites.
			</p>
		</div>
	</section>
	<ScientificResourcesTestimonials />

	<section class="experts-block--articles" aria-labelledby="articles-scientifiques-title">
		<div class="experts-block-inner">
			<Title text="Les articles scientifiques" level='3' />
			<div class="articles-grid">
				<ScientificArticle
					title="Cas de choc acoustique avec activation post-traumatique du trijumeau et du système autonome"
					pdfFrench="/articles-scientifiques/Cas de choc acoustique avec activation post-traumatique du trijumeau et du système autonome - Français.pdf"
					pdfEnglish="/articles-scientifiques/Case of acoustic shock with  post-trauma trigeminal-autonomic activation.pdf"
					pdfFrenchLabel="Français"
					pdfEnglishLabel="English"
				/>
				
				<ScientificArticle
					title="Un modèle intégratif expliquant l’ensemble des symptômes déclenchés après un choc acoustique"
					pdfFrench="/articles-scientifiques/Un modèle intégratif expliquant l’ensemble des symptômes déclenchés après un choc acoustique traduit en français.pdf"
					pdfEnglish="/articles-scientifiques/An Integrative Model Accounting for the Symptom Cluster Triggered After an Acoustic Shock to English.pdf"
					pdfFrenchLabel="Français"
					pdfEnglishLabel="English"
				/>
				
				<ScientificArticle
					title="Syndrome tenseur du tympan tonique chez les patients souffrant d’acouphènes et d’hyperacousie _ une étude de prévalence multi-clinique"
					pdfFrench="/articles-scientifiques/Syndrome tenseur du tympan tonique chez les patients souffrant d’acouphènes et d’hyperacousie _ une étude de prévalence multi-clinique en Français.pdf"
					pdfEnglish="/articles-scientifiques/Tonic tensor tympani syndrome in tinnitus and hyperacusis patients - A multi clinic prevalence study.pdf"
					pdfFrenchLabel="Français"
					pdfEnglishLabel="English"
				/>
		</div>
		</div>
	</section>

	<div class="experts-content">
		<section class="experts-block experts-block--research" aria-labelledby="recherche-essais-title">
			<div class="experts-block-header">
				<Title text="La recherche et les essais cliniques en cours" level='3' />
				<span class="status-pill status-pill--research">Mise à jour en cours</span>
			</div>
			<div class="research-placeholder">
				<span class="research-placeholder-icon">🔬</span>
				<p>Cette section sera bientôt enrichie avec les derniers essais cliniques et travaux de recherche en cours sur l'hyperacousie.</p>
			</div>
		</section>
	</div>

</Layout>
