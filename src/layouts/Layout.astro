---
// Imports
import Footer from '../ui/Footer/Footer.astro';
import Header from '../ui/Header/Header.astro';
import '../styles/variables.css';
import '../ui/Button/Button.css';
import ScrollToTop from '../components/ScrollToTop/ScrollToTop.astro';

export interface Props {
  title?: string;
  description?: string;
}

const { 
  title = 'Hyperacousie Solidarité', 
  description = 'Ensemble pour sensibiliser et soutenir les personnes touchées par l\'hyperacousie'
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Oleo+Script+Swash+Caps:wght@400;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/src/styles/variables.css" />

    <style>
      * {
        margin: 0 !important;
        padding: 0 !important;
        box-sizing: border-box;
      }
      html {
        scroll-behavior: smooth;
        overflow-x: hidden;
      }
      html, body {
        margin: 0 !important;
        padding: 0 !important;
        background-color: var(--color-background-white);
        color: var(--color-black);
        font-family: system-ui, -apple-system, sans-serif;
        min-height: 100vh;
      }
      body {
        position: relative;
        overflow-x: hidden;
        /* Espace pour le header fixe - sera ajusté dynamiquement */
        padding-top: var(--header-height, 120px);
      }
      h1, h2, h3, h4, h5, h6, p {
        margin: 0 !important;
        color: var(--color-black);
      }
      *, *::before, *::after {
        color: var(--color-black);
      }
      /* Fix pour le header fixe */
      body > header {
        margin: 0 !important;
        padding: 0 !important;
      }
    </style>

    <!-- Metricool Tracking -->
    <script is:inline>
      (function(){
        var e = document.createElement("script");
        e.type = "text/javascript";
        e.async = true;
        e.src = "https://tracker.metricool.com/resources/be.js";
        document.head.appendChild(e);
        e.onload = function(){
          beTracker.t({ hash: "${Astro.env.PUBLIC_METRICOOL_ID}" });
        };
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header currentPath={currentPath} />

    <main class="flex-1 w-full" id="main-content">
      <slot />
      <ScrollToTop />
    </main>

    <Footer />

    <!-- Script pour gérer le header fixe -->
    <script is:inline>
      (function() {
        // Calculer et définir la hauteur du header
        function setHeaderHeight() {
          const header = document.querySelector('.header-container');
          if (header) {
            const height = header.offsetHeight;
            document.documentElement.style.setProperty('--header-height', height + 'px');
          }
        }

        // Ajouter la classe scrolled lors du scroll
        function handleScroll() {
          const header = document.querySelector('.header-container');
          if (header) {
            if (window.scrollY > 10) {
              header.classList.add('scrolled');
            } else {
              header.classList.remove('scrolled');
            }
          }
        }

        // Initialiser
        setHeaderHeight();
        handleScroll();

        // Écouter les événements
        window.addEventListener('scroll', handleScroll, { passive: true });
        window.addEventListener('resize', setHeaderHeight);

        // Recalculer après le chargement complet
        window.addEventListener('load', setHeaderHeight);
      })();
    </script>
  </body>
</html>