---
import './PetiteBoutique.css';
import Button from '../../ui/Button/Button.astro';

const shopUrl = 'https://www.helloasso.com/associations/hyperacousie-solidarite/boutiques/depliant-hyperacousie-solidarite';
---

<section class="petite-boutique" aria-labelledby="petite-boutique-title">
  <a href={shopUrl} target="_blank" rel="noopener noreferrer" aria-label="Accéder à la petite boutique Hyperacousie Solidarité sur HelloAsso">
    <img src="/La-petite-boutique.webp" alt="La petite boutique" class="petite-boutique-img" width="320" height="auto" loading="lazy" />
  </a>

  <div class="petite-boutique-content">
    <p id="petite-boutique-title" class="petite-boutique-subtitle">Partager par <strong>HYPERACOUSIE SOLIDARITÉ</strong></p>
    <p>Notre petite boutique, où vous trouverez :</p>
    <ul>
      <li>des supports de sensibilisation sur l'hyperacousie à diffuser (cabinets médicaux, professionnels de santé…).</li>
      <li>des stickers roses "handicap auditif" à coller sur vos casques… ou ailleurs</li>
    </ul>

    <div class="petite-boutique-btn-wrapper">
      <Button href={shopUrl} target="_blank" rel="noopener noreferrer" variant="coral" size="sm">
        Accéder à la boutique
      </Button>
    </div>
   
  </div>
   <div class="petite-boutique-images-droite">
      <img src="/oreille-rose.webp" alt="Oreille rose" class="adhesions-support-img rotate-right-1" style="--sticker-delay: 220ms;" width="120" height="auto" loading="lazy" />
      <img src="/stickers-ours.webp" alt="Stickers ours" class="adhesions-support-img rotate-left-2" style="--sticker-delay: 300ms;" width="120" height="auto" loading="lazy" />
    </div>
</section>
