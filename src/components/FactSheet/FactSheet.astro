---
import Card from "../Card/Card.astro";
import Button from "../../ui/Button/Button.astro";
import '../../styles/variables.css';
import './FactSheet.css';


const factSheets = [
  {
    id: 1,
    title: "L'hyperacousie expliquée à l'entourage",
    img: "/fiches-pratiques/L'hyperacousie expliquée à l'entourage.pdf",
    thumbnail: "/fiches-pratiques/expliquer à l'entourage miniature.webp"
  },
  {
    id: 2,
    title: "Kit de survie de l'hyperacousique",
    img: "/fiches-pratiques/KIT de survie de l'hyperacousique.pdf",
    thumbnail: "/fiches-pratiques/kit survie miniature.webp"
  },
  {
    id: 3,
    title: "Casque et conduite hyperacousique",
    img: "/fiches-pratiques/Casque et conduite hyperacousique.pdf",
    thumbnail: "/fiches-pratiques/casque et conduite miniature.webp"
  },
  {
    id: 4,
    title: "Tableau comparatif - Les casques antibruit passifs",
    img: "/fiches-pratiques/Tableau comparatif casques.pdf",
    thumbnail: "/fiches-pratiques/Tableau-comparatif-casques.webp"
  }
];
---
<section class="section-fact-sheet">
    <div class="fact-sheet-list">
    {factSheets.map((sheet) => (
      <Card
        className="fact-sheet-card"
        subtitle={sheet.title}
        imageSrc={sheet.thumbnail}
        imageAlt={sheet.title}
      >
        <Button
          variant="teal"
          size="sm"
          href={sheet.img}
          target="_blank"
          rel="noopener"
          download="true"
        >
          Télécharger
        </Button>
      </Card>
    ))}
  </div>
</section>