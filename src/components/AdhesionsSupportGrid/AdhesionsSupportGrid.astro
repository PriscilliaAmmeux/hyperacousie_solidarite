---
import './AdhesionsSupportGrid.css';
import Donations from '../../ui/Donations/Donations.astro';
---

<section class="adhesions-support-grid-wrapper" aria-label="Adhesions et dons">
  <div class="adhesions-support-grid">
    <div class="adhesions-support-images adhesions-support-images-left">
      <img src="/stickers.webp" alt="Stickers Handicap Hyperacousie" class="adhesions-support-img rotate-left-1" style="--sticker-delay: 80ms;" width="200" height="auto" loading="lazy" />
      <img src="/oreille-rose.webp" alt="Oreille rose" class="adhesions-support-img rotate-right-1" style="--sticker-delay: 220ms;" width="200" height="auto" loading="lazy" />
    </div>

    <div class="adhesions-support-donations">
      <Donations />
    </div>

    <div class="adhesions-support-images adhesions-support-images-right">
      <img src="/carte handicap.webp" alt="Carte handicap auditif" class="adhesions-support-img rotate-right-2" style="--sticker-delay: 160ms;" width="200" height="auto" loading="lazy" />
      <img src="/stickers-ours.webp" alt="Stickers ours" class="adhesions-support-img rotate-left-2" style="--sticker-delay: 300ms;" width="200" height="auto" loading="lazy" />
    </div>
  </div>
</section>
