---
import Title from "../../ui/Title/Title.astro";
import "../../styles/variables.css";
import "./Presse.css";

type AvatarVariant = {
	background: string;
	shape: string;
	accent: string;
};

const avatarVariants = [
	{ background: "#fff4f2", shape: "#ff6f61", accent: "#ffd8d3" },
	{ background: "#eefbf8", shape: "#12b6a8", accent: "#c9f1ed" },
	{ background: "#f7efe9", shape: "#3c1914", accent: "#e7c7b8" },
	{ background: "#f5fbfa", shape: "#3c1914", accent: "#bceae4" },
] satisfies AvatarVariant[];

const createProfilePreview = ({ background, shape, accent }: AvatarVariant) =>
	`data:image/svg+xml,${encodeURIComponent(`
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 480 320" role="img" aria-hidden="true">
			<rect width="480" height="320" rx="32" fill="${background}" />
			<rect x="28" y="28" width="424" height="264" rx="24" fill="#ffffff" fill-opacity="0.78" />
			<circle cx="118" cy="114" r="54" fill="${accent}" />
			<circle cx="118" cy="103" r="24" fill="${shape}" />
			<path d="M72 168c10-28 31-44 46-44s36 16 46 44" fill="${shape}" />
			<rect x="198" y="86" width="164" height="14" rx="7" fill="${shape}" fill-opacity="0.92" />
			<rect x="198" y="116" width="130" height="10" rx="5" fill="${shape}" fill-opacity="0.24" />
			<rect x="198" y="138" width="150" height="10" rx="5" fill="${shape}" fill-opacity="0.18" />
			<rect x="60" y="216" width="126" height="34" rx="17" fill="${shape}" />
			<rect x="214" y="222" width="160" height="12" rx="6" fill="${shape}" fill-opacity="0.14" />
			<rect x="390" y="52" width="34" height="34" rx="17" fill="${accent}" />
		</svg>
	`)}`;

const pressArticles = [
	{
		title: "Témoignage d'Alexandra",
		image: "/articles-presse/Article de presse Témoignage-Alexandra.webp",
		source: "Le courrier de l'ouest Saumur",
		profilePhoto: "/photo-presse/photo-Alexandra.webp",
	},
	{
		title: "Témoignage de Barbara",
		image: "/articles-presse/Article de presse Témoignage-Barbara.webp",
		source: "La république de Seine-et-Marne",
		profilePhoto: "/photo-presse/photo-Barbara.webp",
	},
	{
		title: "Témoignage de Florent",
		image: "/articles-presse/Article de presse Témoignage-Florent.webp",
		source: "Journal La Nouvelle République de la Vienne",
		profilePhoto: "/photo-presse/photo-Florent.webp",
	},
	{
		title: "Témoignage de Nathan",
		image: "/articles-presse/Article de presse Témoignage-Nathan-2.webp",
		source: "Le journal des Sables",
		profilePhoto: "/photo-presse/photo-Nathan.webp",
	},
	{
		title:"Témoignage de Mélina",
		image: "/articles-presse/Article de presse Témoignage-Mélina.webp",
		source: "",
		profilePhoto: "/photo-presse/photo-Mélina.webp",
	},
	{
		title:"Témoignage d'Aurélien",
		image: "/articles-presse/Article de presse Témoignage-Aurélien.webp",
		source: "Le parisien",
		profilePhoto: "/photo-aurélien.webp",
	},
	{
		title:"Témoignage d'Aurélien",
		image: "/articles-presse/Article de presse Témoignage-Aurélien-Bruyat.webp",
		source: "France-Monde",
		profilePhoto: "/photo-aurélien.webp",
	}
];
---

<section class="press-section">
	<Title text="La presse parle de nous" level="2" className="mb-4 section-title" />
	<div id="press-grid" class="press-grid">
		{pressArticles.map((article, index) => (
			<a href={article.image} download={`${article.title}.webp`} class="press-card">
				<div class="press-card-image-wrapper">
					<img src={article.profilePhoto ?? createProfilePreview(avatarVariants[index % avatarVariants.length])} alt={article.profilePhoto ? `Photo de ${article.title}` : `Illustration profil pour ${article.title}`} loading="lazy" />
					<div class="press-card-badge">
						<svg class="pdf-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
							<polyline points="7 10 12 15 17 10"/>
							<line x1="12" y1="15" x2="12" y2="3"/>
						</svg>
						<span>Télécharger</span>
					</div>
				</div>
				<div class="press-card-content">
					<p>{article.title}</p>
					<span>{article.source}</span>
				</div>
			</a>
		))}
	</div>

	<div class="press-video-wrapper">
		<Title text="Radio et podcast" level="2" className="mb-4 section-title" />
		<div class="swiper press-video-swiper">
			<div class="swiper-wrapper">
				<div class="swiper-slide">
					<div class="press-video-frame">
						<iframe
							class="press-video"
							src="https://www.youtube.com/embed/cn6T4Vt6XuA"
							title="Interview sur France Inter"
							loading="lazy"
							allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
							referrerpolicy="strict-origin-when-cross-origin"
							allowfullscreen
						></iframe>
					</div>
				</div>
				<div class="swiper-slide">
					<div class="press-video-frame">
						<iframe
							class="press-video"
							src="https://www.youtube.com/embed/Lw-RGtAhDP4"
							title="Interview sur Actu"
							loading="lazy"
							allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
							referrerpolicy="strict-origin-when-cross-origin"
							allowfullscreen
						></iframe>
					</div>
				</div>
			</div>
			<div class="swiper-button-prev press-video-nav-prev"></div>
			<div class="swiper-button-next press-video-nav-next"></div>
		</div>
	</div>
</section>

<script src="./Presse.js" ></script>
